---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeFilters from '../../components/HomeFilters.astro';
import HomeRoster from '../../components/HomeRoster.astro';
import changelog from '../../content/site/changelog.json';
import '../../styles/common.css';
import '../../styles/home.css';
import { getHomePageData } from '../../utils/home-page';
import { t } from '../../utils/i18n';
import { localizedPath, sitePath } from '../../utils/paths';
import { getLanguageStaticPaths } from '../../utils/routes';

export const getStaticPaths = getLanguageStaticPaths;

const requestedLang = Array.isArray(Astro.params.lang) ? Astro.params.lang[0] : Astro.params.lang;
const { characters, lang, latestVersion, locale, recentlyUpdatedCharacters } = getHomePageData(requestedLang ?? 'en');
const latestChangelogEntry = changelog.groups[0]?.entries?.[0];
const lastUpdatedLabel = t(locale, 'ui', 'Last Updated', undefined, false) || 'Last Updated';
const changelogLabel = t(locale, 'ui', 'Changelog', undefined, false);
const latestChangelogLabel = latestChangelogEntry
  ? `${lastUpdatedLabel}: ${latestChangelogEntry.changes}`
  : changelogLabel;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href={sitePath('favicon.webp')} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Genshin Builds</title>
  </head>
  <body data-element="base">
    <Header locale={locale} lang={lang} />
    <main>
      <h1>Genshin Builds</h1>
      <p class="home-disclaimer">
        {t(locale, 'ui', 'Home translation disclaimer', undefined, false)}
      </p>
      {
        latestChangelogEntry?.changes && (
          <a class="home-last-update" href={localizedPath(lang, 'changelog')} aria-label={latestChangelogLabel}>
            <h2>{lastUpdatedLabel}</h2>
            <p class="home-last-update-change">{latestChangelogEntry.changes}</p>
            <p class="home-last-update-metadata">
              <time>{latestChangelogEntry.date}</time>
              {latestChangelogEntry.appliedBy && <span>Applied by {latestChangelogEntry.appliedBy}</span>}
            </p>
          </a>
        )
      }
      <HomeFilters
        latestVersion={latestVersion}
        locale={locale}
        recentlyUpdatedCount={recentlyUpdatedCharacters.length}
      />
      <HomeRoster characters={characters} locale={locale} lang={lang} />
    </main>
    <Footer lang={lang} />
    <script>
      import '../../scripts/card-filters';
    </script>
    <script>
      const panel = document.createElement('pre');
      panel.setAttribute('aria-label', 'Temp diag pour debug');
      Object.assign(panel.style, {
        position: 'fixed',
        right: '8px',
        bottom: '8px',
        left: '8px',
        zIndex: '2147483647',
        maxHeight: '30vh',
        overflow: 'auto',
        margin: '0',
        padding: '10px',
        border: '2px solid #ffdf78',
        borderRadius: '8px',
        background: 'rgba(0, 0, 0, 0.94)',
        color: '#fff',
        font: '11px/1.35 monospace',
        whiteSpace: 'pre-wrap',
        overflowWrap: 'anywhere',
      });
      document.body.append(panel);

      const updateDiagnostics = () => {
        const form = document.querySelector<HTMLElement>('.filter-bar');
        const measure = (element: Element | null) => {
          if (!element) return null;
          const { x, y, width, height } = element.getBoundingClientRect();
          return { x, y, width, height };
        };
        const fields = form
          ? [...form.querySelectorAll<HTMLElement>('.filter-field')].map((field) => ({
              label: field.firstChild?.textContent?.trim(),
              field: measure(field),
              control: measure(field.querySelector('input, select')),
            }))
          : [];

        panel.textContent = JSON.stringify(
          {
            userAgent: navigator.userAgent,
            viewport: {
              innerWidth: window.innerWidth,
              documentWidth: document.documentElement.clientWidth,
              visualWidth: window.visualViewport?.width,
              visualScale: window.visualViewport?.scale,
              devicePixelRatio: window.devicePixelRatio,
              screen: { width: screen.width, height: screen.height },
              matches650px: matchMedia('(max-width: 650px)').matches,
            },
            filter: form
              ? {
                  box: measure(form),
                  gridColumns: getComputedStyle(form).gridTemplateColumns,
                  fields,
                }
              : null,
          },
          null,
          2,
        );
      };

      requestAnimationFrame(() => setTimeout(updateDiagnostics, 150));
      window.addEventListener('resize', updateDiagnostics);
      window.visualViewport?.addEventListener('resize', updateDiagnostics);
    </script>
  </body>
</html>
