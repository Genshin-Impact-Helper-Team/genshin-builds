---
type NoteItem = {
  name: string;
  noteId?: string;
};

type Props = {
  items: NoteItem[];
};

const { items: noteItems } = Astro.props as Props;
const firstItem = noteItems[0];
const getAriaLabel = (item: NoteItem) =>
  item.name ? `Show note for ${item.name}` : 'Show note';
const getMarkerLabel = (item: NoteItem) =>
  item.name ? `Has note for ${item.name}` : 'Has note';
---

{
  noteItems.length === 1 && firstItem ? (
    firstItem.noteId ? (
      <button
        class="note-button row-note-action row-note-button"
        type="button"
        data-note-id={firstItem.noteId}
        aria-label={getAriaLabel(firstItem)}
        aria-expanded="false"
      >
        ⓘ
      </button>
    ) : (
      <span
        class="note-marker-text row-note-action row-note-button"
        aria-label={getMarkerLabel(firstItem)}
      >
        ⓘ
      </span>
    )
  ) : noteItems.length > 0 ? (
    <span class="row-note-action">
      {noteItems.map((item) =>
        item.noteId ? (
          <button
            class="note-button row-note-button"
            type="button"
            data-note-id={item.noteId}
            aria-label={getAriaLabel(item)}
            aria-expanded="false"
          >
            ⓘ
          </button>
        ) : (
          <span
            class="note-marker-text row-note-button"
            aria-label={getMarkerLabel(item)}
          >
            ⓘ
          </span>
        ),
      )}
    </span>
  ) : null
}
