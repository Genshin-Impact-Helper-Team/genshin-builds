---
import { Image } from 'astro:assets';
import type { AssetImage } from '../utils/item-assets';
import { t } from '../utils/i18n';
import Filters from './Filters.astro';
import SortBy from './SortBy.astro';

type WeaponBrowserData = {
  rarities: number[];
  substats: {
    id: string;
    label: string;
  }[];
  sources: {
    id: string;
    label: string;
  }[];
  weaponTypes: {
    id: string;
    label: string;
  }[];
  weapons: {
    id: string;
    image: AssetImage | '';
    name: string;
    rarity: number;
    source: string;
    type: string;
    typeLabel: string;
    versionReleased: string;
    sourceName: string;
    substat: string;
    substatName: string;
    level1BaseAttack: string;
    levelMaxBaseAttack: string;
    level1Substat: string;
    levelMaxSubstat: string;
    rankingUsage: {
      characterName: string;
      characterRarity: string;
      href: string;
      isWip?: boolean;
      rank?: number;
    }[];
    passiveHtml: string;
    refinementValues: (number | number[] | undefined)[][];
  }[];
};

const { data, locale } = Astro.props as {
  data: WeaponBrowserData;
  locale: any;
};

const allLabel = t(locale, 'ui', 'All');
const resultsLabel = t(locale, 'ui', 'Results');
const noResultsLabel = t(locale, 'ui', 'No weapons found', undefined, false);
const sourceLabel = t(locale, 'ui', 'Source', undefined, false);
const substatsLabel = t(locale, 'ui', 'Substats', undefined, false);
const searchByNameLabel = t(locale, 'ui', 'Search by name');
const weaponLabel = t(locale, 'ui', 'Weapon');
const rarityLabel = t(locale, 'ui', 'Rarity');
const searchLabel = t(locale, 'ui', 'Search');
const descriptionLabel = t(locale, 'ui', 'Description', undefined, false);
const rankedOnLabel = t(locale, 'ui', 'Weapon ranked on', undefined, false);
const noRankingMentionsLabel = t(locale, 'ui', 'No weapon ranking mentions', undefined, false);
const level1Label = t(locale, 'ui', 'Level 1', undefined, false);
const maxLevelLabel = t(locale, 'ui', 'Max Level', undefined, false);
const statLabel = t(locale, 'ui', 'Stat', undefined, false);
const baseAttackLabel = t(locale, 'ui', 'Base ATK', undefined, false);
const sortByLabel = t(locale, 'ui', 'Sort by', undefined, false);
const releaseDateLabel = t(locale, 'ui', 'Release date', undefined, false);
const newestLabel = t(locale, 'ui', 'Newest', undefined, false);
const sortOptions = [
  { value: 'name', label: `${weaponLabel} - A-Z` },
  { value: 'release', label: `${releaseDateLabel} - ${newestLabel}` },
];
const filterFields = [
  {
    type: 'search' as const,
    name: 'search',
    label: searchLabel,
    placeholder: searchByNameLabel,
  },
  {
    type: 'select' as const,
    name: 'type',
    label: weaponLabel,
    options: [
      { value: '', label: allLabel },
      ...data.weaponTypes.map((type) => ({ value: type.id, label: type.label })),
    ],
  },
  {
    type: 'select' as const,
    name: 'rarity',
    label: rarityLabel,
    options: [
      { value: '', label: allLabel },
      ...data.rarities.map((rarity) => ({
        value: String(rarity),
        label: `${rarity}\u2605`,
      })),
    ],
  },
  {
    type: 'select' as const,
    name: 'source',
    label: sourceLabel,
    options: [
      { value: '', label: allLabel },
      ...data.sources.map((source) => ({
        value: source.id,
        label: source.label,
      })),
    ],
  },
  {
    type: 'select' as const,
    name: 'substat',
    label: substatsLabel,
    options: [
      { value: '', label: allLabel },
      ...data.substats.map((substat) => ({
        value: substat.id,
        label: substat.label,
      })),
    ],
  },
];
---

<section class="weapon-browser" data-weapon-browser>
  <Filters id="weapon-filters" kind="weapon" fields={filterFields} />

  <div class="browser-results-header">
    <p data-weapon-count data-results-label={resultsLabel} aria-live="polite">
      {data.weapons.length}
      {resultsLabel}
    </p>
    <SortBy label={sortByLabel} form="weapon-filters" options={sortOptions} selected="name" />
  </div>

  <div class="browser-grid">
    {
      data.weapons.map((weapon) => (
        <article
          class="browser-entry"
          data-weapon-card
          data-id={weapon.id}
          data-name={weapon.name}
          data-rarity={weapon.rarity}
          data-source={weapon.source}
          data-substat={weapon.substat}
          data-type={weapon.type}
          data-version-released={weapon.versionReleased}
        >
          <header class="browser-entry-header">
            <div class="browser-entry-title">
              <div class={`image-square-bg browser-entry-image${weapon.image ? '' : ' is-empty'}`}>
                {weapon.image && (
                  <Image
                    src={weapon.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    densities={[1, 2]}
                  />
                )}
              </div>
              <div>
                <h2>{weapon.name}</h2>
                <p>{weapon.typeLabel}</p>
              </div>
            </div>
            <span class="browser-entry-rarity">
              {weapon.rarity}
              {'\u2605'}
            </span>
          </header>

          <table class="weapon-stat-table">
            <thead>
              <tr>
                <th>{statLabel}</th>
                <th>{level1Label}</th>
                <th>{maxLevelLabel}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">{baseAttackLabel}</th>
                <td>{weapon.level1BaseAttack || '-'}</td>
                <td>{weapon.levelMaxBaseAttack || '-'}</td>
              </tr>
              {weapon.substatName && (
                <tr>
                  <th scope="row">{weapon.substatName}</th>
                  <td>{weapon.level1Substat || '-'}</td>
                  <td>{weapon.levelMaxSubstat || '-'}</td>
                </tr>
              )}
            </tbody>
          </table>

          {weapon.passiveHtml && (
            <section class="weapon-entry-passive" aria-label={`${weapon.name} ${descriptionLabel}`}>
              <div class="weapon-entry-section-header">
                <h3>{descriptionLabel}</h3>
                <div class="weapon-refinement-buttons">
                  {[1, 2, 3, 4, 5].map((refinement) => (
                    <button
                      class="refinement-button weapon-refinement-button"
                      type="button"
                      data-weapon-refinement={`r${refinement}`}
                      aria-pressed={refinement === 1 ? 'true' : 'false'}
                    >
                      R{refinement}
                    </button>
                  ))}
                </div>
              </div>

              <div class="weapon-passive">
                <div
                  data-weapon-refinement-panel="r1"
                  data-refinement-values={JSON.stringify(weapon.refinementValues)}
                  set:html={weapon.passiveHtml}
                />
              </div>
            </section>
          )}

          <section class="browser-usage" aria-label={`${weapon.name} ${rankedOnLabel}`}>
            <h3 class="browser-usage-title">{rankedOnLabel}</h3>
            {weapon.rankingUsage.length > 0 ? (
              <div class="browser-usage-list">
                {weapon.rankingUsage.map((usage) => (
                  <a
                    class="browser-usage-chip"
                    href={usage.href}
                    data-rarity={usage.characterRarity}
                    data-wip={usage.isWip}
                  >
                    <strong class="usage-rank-number">{usage.isWip ? 'WIP' : usage.rank}</strong>
                    <span class="browser-usage-character">{usage.characterName}</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="browser-usage-empty">{noRankingMentionsLabel}</p>
            )}
          </section>

          <footer class="weapon-entry-source">
            <span>{sourceLabel}</span>
            <strong>{weapon.sourceName}</strong>
          </footer>
        </article>
      ))
    }
  </div>

  <p class="browser-empty" data-weapon-empty hidden>{noResultsLabel}</p>
</section>

<script>
  import '../scripts/card-filters';
</script>
