---
import { Image } from 'astro:assets';
import type { AssetImage } from '../utils/item-assets';
import { t } from '../utils/i18n';

type ArtifactSetBrowserData = {
  artifactSets: {
    id: string;
    image: AssetImage | '';
    name: string;
    rarity: number;
    versionReleased: string;
    bonuses: {
      id: string;
      label: string;
      html: string;
    }[];
    tags: string[];
    tagGroups: string[];
    fourPieceUsage: {
      characterName: string;
      characterRarity: string;
      href: string;
      isWip?: boolean;
      rank?: number;
    }[];
  }[];
  rarities: number[];
  tagOptionGroups: {
    label: string;
    options: {
      id: string;
      label: string;
    }[];
  }[];
};

const { data, locale } = Astro.props as {
  data: ArtifactSetBrowserData;
  locale: any;
};

const allLabel = t(locale, 'ui', 'All');
const resultsLabel = t(locale, 'ui', 'Results');
const noResultsLabel = t(
  locale,
  'ui',
  'No artifact sets found',
  undefined,
  false,
);
const searchByNameLabel = t(locale, 'ui', 'Search by name');
const rarityLabel = t(locale, 'ui', 'Rarity');
const searchLabel = t(locale, 'ui', 'Search');
const tagLabel = t(locale, 'ui', 'Set Effect', undefined, false);
const artifactSetsLabel = t(locale, 'ui', 'Artifacts Sets', undefined, false);
const sortByLabel = t(locale, 'ui', 'Sort by', undefined, false);
const releaseDateLabel = t(locale, 'ui', 'Release date', undefined, false);
const newestLabel = t(locale, 'ui', 'Newest', undefined, false);
const sortOptions = [
  { value: 'name', label: `${artifactSetsLabel} - A-Z` },
  { value: 'release', label: `${releaseDateLabel} - ${newestLabel}` },
];
const mentionedOnLabel = t(
  locale,
  'ui',
  'Artifact set mentioned on',
  undefined,
  false,
);
const noMentionsLabel = t(
  locale,
  'ui',
  'No artifact set mentions',
  undefined,
  false,
);
---

<section class="artifact-set-browser" data-artifact-browser>
  <form
    class="home-filters artifact-set-filters"
    id="artifact-set-filters"
    data-artifact-filters
  >
    <label class="home-search">
      {searchLabel}
      <input
        type="search"
        name="search"
        placeholder={searchByNameLabel}
        autocomplete="off"
      />
    </label>

    <div class="home-select-filter">
      {rarityLabel}
      <select class="home-native-select" name="rarity" aria-label={rarityLabel}>
        <option value="">{allLabel}</option>
        {
          data.rarities.map((rarity) => (
            <option value={String(rarity)}>
              {rarity}
              {'\u2605'}
            </option>
          ))
        }
      </select>
    </div>

    <div class="home-select-filter">
      {tagLabel}
      <select class="home-native-select" name="tagGroups" aria-label={tagLabel}>
        <option value="">{allLabel}</option>
        {
          data.tagOptionGroups.map((group) => (
            <optgroup label={group.label}>
              {group.options.map((tag) => (
                <option value={tag.id}>{tag.label}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </div>
  </form>

  <div class="artifact-set-browser-header">
    <p data-artifact-count data-results-label={resultsLabel} aria-live="polite">
      {data.artifactSets.length}
      {resultsLabel}
    </p>
    <label class="roster-sort">
      {sortByLabel}
      <select
        class="home-native-select"
        name="sort"
        form="artifact-set-filters"
        aria-label={sortByLabel}
      >
        {
          sortOptions.map((option) => (
            <option value={option.value} selected={option.value === 'name'}>
              {option.label}
            </option>
          ))
        }
      </select>
    </label>
  </div>

  <div class="artifact-set-grid">
    {
      data.artifactSets.map((artifactSet) => (
        <article
          class={`artifact-set-entry rarity-${artifactSet.rarity}`}
          data-artifact-card
          data-name={artifactSet.name}
          data-rarity={artifactSet.rarity}
          data-tags={artifactSet.tags.join(' ')}
          data-tag-groups={artifactSet.tagGroups.join(' ')}
          data-version-released={artifactSet.versionReleased}
        >
          <header class="artifact-set-entry-header">
            <div class="artifact-set-entry-title">
              <div
                class={`artifact-set-entry-image${artifactSet.image ? '' : ' is-empty'}`}
              >
                {artifactSet.image && (
                  <Image
                    src={artifactSet.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    densities={[1, 2]}
                  />
                )}
              </div>
              <div>
                <h2>{artifactSet.name}</h2>
              </div>
            </div>
            <span class="artifact-set-entry-rarity">
              {artifactSet.rarity}
              {'\u2605'}
            </span>
          </header>

          <div class="artifact-set-bonus-list">
            {artifactSet.bonuses.map((bonus) => (
              <section
                class="artifact-set-bonus"
                aria-label={`${artifactSet.name} ${bonus.label}`}
              >
                <h3>{bonus.label}</h3>
                <div set:html={bonus.html} />
              </section>
            ))}
          </div>

          <section
            class="artifact-set-usage"
            aria-label={`${artifactSet.name} ${mentionedOnLabel}`}
          >
            <h3>{mentionedOnLabel}</h3>
            {artifactSet.fourPieceUsage.length > 0 ? (
              <div class="artifact-set-usage-list">
                {artifactSet.fourPieceUsage.map((usage) => (
                  <a
                    class={`artifact-set-usage-chip character-rarity-${usage.characterRarity}${usage.isWip ? ' is-wip' : ''}`}
                    href={usage.href}
                  >
                    {(usage.rank || usage.isWip) && (
                      <strong class="usage-rank-number">
                        {usage.isWip ? 'WIP' : usage.rank}
                      </strong>
                    )}
                    <span class="artifact-set-usage-character">
                      {usage.characterName}
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="artifact-set-usage-empty">{noMentionsLabel}</p>
            )}
          </section>
        </article>
      ))
    }
  </div>

  <p class="artifact-set-empty" data-artifact-empty hidden>{noResultsLabel}</p>
</section>

<script>
  import '../scripts/card-filters';
</script>
