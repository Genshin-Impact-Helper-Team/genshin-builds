---
import { Image } from 'astro:assets';
import type { AssetImage } from '../utils/item-assets';
import { t } from '../utils/i18n';
import Filters from './Filters.astro';
import SortBy from './SortBy.astro';

type ArtifactSetBrowserData = {
  artifactSets: {
    id: string;
    image: AssetImage | '';
    name: string;
    rarity: number;
    versionReleased: string;
    bonuses: {
      id: string;
      label: string;
      html: string;
    }[];
    tags: string[];
    tagGroups: string[];
    fourPieceUsage: {
      characterName: string;
      characterRarity: string;
      href: string;
      isWip?: boolean;
      rank?: number;
    }[];
  }[];
  rarities: number[];
  tagOptionGroups: {
    label: string;
    options: {
      id: string;
      label: string;
    }[];
  }[];
};

const { data, locale } = Astro.props as {
  data: ArtifactSetBrowserData;
  locale: any;
};

const allLabel = t(locale, 'ui', 'All');
const resultsLabel = t(locale, 'ui', 'Results');
const noResultsLabel = t(locale, 'ui', 'No artifact sets found', undefined, false);
const searchByNameLabel = t(locale, 'ui', 'Search by name');
const rarityLabel = t(locale, 'ui', 'Rarity');
const searchLabel = t(locale, 'ui', 'Search');
const tagLabel = t(locale, 'ui', 'Set Effect', undefined, false);
const artifactSetsLabel = t(locale, 'ui', 'Artifacts Sets', undefined, false);
const sortByLabel = t(locale, 'ui', 'Sort by', undefined, false);
const releaseDateLabel = t(locale, 'ui', 'Release date', undefined, false);
const newestLabel = t(locale, 'ui', 'Newest', undefined, false);
const sortOptions = [
  { value: 'name', label: `${artifactSetsLabel} - A-Z` },
  { value: 'release', label: `${releaseDateLabel} - ${newestLabel}` },
];
const mentionedOnLabel = t(locale, 'ui', 'Artifact set mentioned on', undefined, false);
const noMentionsLabel = t(locale, 'ui', 'No artifact set mentions', undefined, false);
const filterFields = [
  {
    type: 'search' as const,
    name: 'search',
    label: searchLabel,
    placeholder: searchByNameLabel,
  },
  {
    type: 'select' as const,
    name: 'rarity',
    label: rarityLabel,
    options: [
      { value: '', label: allLabel },
      ...data.rarities.map((rarity) => ({
        value: String(rarity),
        label: `${rarity}\u2605`,
      })),
    ],
  },
  {
    type: 'select' as const,
    name: 'tagGroups',
    label: tagLabel,
    options: [
      { value: '', label: allLabel },
      ...data.tagOptionGroups.map((group) => ({
        label: group.label,
        options: group.options.map((tag) => ({
          value: tag.id,
          label: tag.label,
        })),
      })),
    ],
  },
];
---

<section class="artifact-set-browser" data-artifact-browser>
  <Filters id="artifact-set-filters" kind="artifact" fields={filterFields} />

  <div class="browser-results-header">
    <p data-artifact-count data-results-label={resultsLabel} aria-live="polite">
      {data.artifactSets.length}
      {resultsLabel}
    </p>
    <SortBy label={sortByLabel} form="artifact-set-filters" options={sortOptions} selected="name" />
  </div>

  <div class="browser-grid">
    {
      data.artifactSets.map((artifactSet) => (
        <article
          class="browser-entry"
          data-artifact-card
          data-id={artifactSet.id}
          data-name={artifactSet.name}
          data-rarity={artifactSet.rarity}
          data-tags={artifactSet.tags.join(' ')}
          data-tag-groups={artifactSet.tagGroups.join(' ')}
          data-version-released={artifactSet.versionReleased}
        >
          <header class="browser-entry-header">
            <div class="browser-entry-title">
              <div class={`image-square-bg browser-entry-image${artifactSet.image ? '' : ' is-empty'}`}>
                {artifactSet.image && (
                  <Image
                    src={artifactSet.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    densities={[1, 2]}
                  />
                )}
              </div>
              <div>
                <h2>{artifactSet.name}</h2>
              </div>
            </div>
            <span class="browser-entry-rarity">
              {artifactSet.rarity}
              {'\u2605'}
            </span>
          </header>

          <div class="artifact-set-effect">
            {artifactSet.bonuses.map((bonus) => (
              <section class="artifact-set-pieces" aria-label={`${artifactSet.name} ${bonus.label}`}>
                <h3>{bonus.label}</h3>
                <div set:html={bonus.html} />
              </section>
            ))}
          </div>

          <section class="browser-usage" aria-label={`${artifactSet.name} ${mentionedOnLabel}`}>
            <h3 class="browser-usage-title">{mentionedOnLabel}</h3>
            {artifactSet.fourPieceUsage.length > 0 ? (
              <div class="browser-usage-list">
                {artifactSet.fourPieceUsage.map((usage) => (
                  <a
                    class="browser-usage-chip"
                    href={usage.href}
                    data-rarity={usage.characterRarity}
                    data-wip={usage.isWip}
                  >
                    {(usage.rank || usage.isWip) && (
                      <strong class="usage-rank-number">{usage.isWip ? 'WIP' : usage.rank}</strong>
                    )}
                    <span class="browser-usage-character">{usage.characterName}</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="browser-usage-empty">{noMentionsLabel}</p>
            )}
          </section>
        </article>
      ))
    }
  </div>

  <p class="browser-empty" data-artifact-empty hidden>{noResultsLabel}</p>
</section>

<script>
  import '../scripts/card-filters';
</script>
