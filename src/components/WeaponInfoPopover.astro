---
type Props = {
  weapon: {
    id?: string;
    name: string;
    info?: unknown;
  };
};

const { weapon } = Astro.props as Props;
---

{
  weapon.id && weapon.info ? (
    <span
      class="info-popover weapon-popover"
      data-info-popover-id={`weapon:${weapon.id}`}
    >
      <span class="info-popover-trigger" role="button" tabindex="0" aria-expanded="false">
        {weapon.name}
      </span>
    </span>
  ) : (
    weapon.name
  )
}
