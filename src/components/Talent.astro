---
import { t } from '../utils/i18n';
import RowNoteAction from './RowNoteAction.astro';

type TalentItem = {
  name: string;
  note?: string;
  noteId?: string;
};

type TalentPriority = {
  items: TalentItem[];
  approx?: boolean;
};

type TalentRecommendations = {
  talents: TalentPriority[];
};

const { talents, locale } = Astro.props as {
  talents: TalentRecommendations;
  locale: any;
};

const hasNoteMarker = (item: TalentItem) => Boolean(item.noteId || item.note);
const talentRows = talents.talents.map(
  (talent: TalentPriority, index: number) => ({
    rank: index + 1,
    mainItems: talent.approx ? talent.items.slice(0, 1) : talent.items,
    alternativeItems: talent.approx ? talent.items.slice(1) : [],
  }),
);
---

<div class="card recommendation-card talent-card">
  <h2>{t(locale, 'ui', 'Talents')}</h2>

  <div class="recommendation-card-body">
    <div class="rank-list">
      {
        talentRows.map((talent) => {
          const noteItems = talent.mainItems.filter(hasNoteMarker);

          return (
            <div class="rank-group">
              <div
                class={`rank-row${noteItems.length > 0 ? ' has-row-note' : ''}`}
              >
                <strong class="rank-number">{talent.rank}</strong>
                <span class="rank-content">
                  {talent.mainItems.map((item, itemIndex) => (
                    <>
                      {itemIndex > 0 && ' = '}
                      <span class="recommendation-label-emphasized">{item.name}</span>
                    </>
                  ))}
                </span>
                {noteItems.length > 0 && <RowNoteAction items={noteItems} />}
              </div>

              {talent.alternativeItems.map((item) => (
                <div
                  class={`rank-row alt${hasNoteMarker(item) ? ' has-row-note' : ''}`}
                >
                  <span class="rank-approx">&asymp;</span>
                  <span class="rank-content">
                    <span class="recommendation-label-emphasized">{item.name}</span>
                  </span>
                  {hasNoteMarker(item) && <RowNoteAction items={[item]} />}
                </div>
              ))}
            </div>
          );
        })
      }
    </div>
  </div>
</div>
