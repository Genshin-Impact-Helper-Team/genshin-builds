---
import { t } from '../utils/i18n';
import Filters from './Filters.astro';

const { latestVersion = '', locale, recentlyUpdatedCount = 0 } = Astro.props;
const hasRecentUpdates = recentlyUpdatedCount > 0;
const recentlyUpdatedLabel = t(
  locale,
  'ui',
  'Recently updated',
  undefined,
  false,
);
const versionLabel = t(locale, 'ui', 'Version', undefined, false);
const versionText = latestVersion ? `${versionLabel} ${latestVersion}` : '';

// Filter options mirror metadata values written onto each character card.
const elements = ['anemo', 'cryo', 'dendro', 'electro', 'geo', 'hydro', 'pyro'];
const rarities = ['4', '5'];
const weapons = ['bow', 'catalyst', 'claymore', 'polearm', 'sword'];
const allLabel = t(locale, 'ui', 'All');

const elementOptions = [
  { value: '', label: allLabel },
  ...elements.map((element) => ({
    value: element,
    label: t(locale, 'element', element),
  })),
];
const rarityOptions = [
  { value: '', label: allLabel },
  ...rarities.map((rarity) => ({
    value: rarity,
    label: `${rarity}\u2605`,
  })),
];
const weaponOptions = [
  { value: '', label: allLabel },
  ...weapons.map((weapon) => ({
    value: weapon,
    label: t(locale, 'ui', weapon),
  })),
];
---

<Filters
  id="character-filters"
  kind="character"
  fields={[
    {
      type: 'search' as const,
      name: 'search',
      label: t(locale, 'ui', 'Search'),
      placeholder: t(locale, 'ui', 'Search by name'),
    },
    {
      type: 'select' as const,
      name: 'element',
      label: t(locale, 'ui', 'Element'),
      options: elementOptions,
    },
    {
      type: 'select' as const,
      name: 'rarity',
      label: t(locale, 'ui', 'Rarity'),
      options: rarityOptions,
    },
    {
      type: 'select' as const,
      name: 'weapon',
      label: t(locale, 'ui', 'Weapon'),
      options: weaponOptions,
    },
    ...(hasRecentUpdates
      ? [
        {
          type: 'checkbox' as const,
          name: 'updated',
          value: 'true',
          label: recentlyUpdatedLabel,
          description: versionText,
          count: recentlyUpdatedCount,
        },
      ]
      : []),
  ]}
/>
